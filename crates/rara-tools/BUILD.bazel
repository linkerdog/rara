load("@crate_index//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "rara_tools",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_name = "rara_tools",
    edition = "2024",
    deps = all_crate_deps(normal = True) + [
        "//crates/file-search:rara_file_search",
        "//crates/rara-apply-patch:rara_apply_patch",
        "//crates/rara-memory:rara_memory",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True) + ["//crates/tool-macros:rara_tool_macros"],
)

rust_test(
    name = "rara_tools_tests",
    crate = ":rara_tools",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    edition = "2024",
    deps = all_crate_deps(normal_dev = True) + [
        "//crates/file-search:rara_file_search",
        "//crates/rara-apply-patch:rara_apply_patch",
        "//crates/rara-memory:rara_memory",
    ],
    proc_macro_deps = all_crate_deps(proc_macro_dev = True) + ["//crates/tool-macros:rara_tool_macros"],
)
